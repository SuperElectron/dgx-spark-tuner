# Copy to .env before `docker compose up`. Never commit .env.

MEM0_PORT=8888
EMBED_PORT=8001
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMS=1024

POSTGRES_USER=sparkmem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sparkmem

# Set to 1 only when you intentionally want configure-memory.sh to allow a
# destructive reset (dimension mismatch, collection wipe). Leave empty.
CONFIRM_RESET_MEMORY=
