.cache/
.claude/box.json
.DS_Store
__pycache__/
.omc/
# Experiment run data stays local; the hypothesis and its conclusion are tracked.
# Git cannot re-include a file inside an excluded directory, so the hypothesis
# directories must be un-excluded first, then their run data excluded again.
research/*/experiments/*
!research/*/experiments/*/
research/*/experiments/*/*
!research/*/experiments/*/HYPOTHESIS.md
!research/*/experiments/*/EXPERIMENT.md
!research/_template/experiments/.gitkeep
research/milestones/
research/*/QUEUE.md
